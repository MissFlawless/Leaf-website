              {stories.map((s, i) => (
                <motion.div
                  key={i}
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: i * 0.07 }}
                  onClick={() => onNav("editor")}
                  className="bg-card border border-border/50 rounded-xl p-4 cursor-pointer hover:shadow-md hover:-translate-y-0.5 transition-all flex gap-3"
