  Search,
  Bell,
  ChevronRight,
  Heart,
  MessageCircle,
  Bookmark,
  Star,
  Play,
  Plus,
  Home,
  Compass,
  GraduationCap,
  User,
  Settings,
  Bold,
  Italic,
  AlignLeft,
  Quote,
  RotateCcw,
  Save,
  Wand2,
  ChevronDown,
