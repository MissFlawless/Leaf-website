} from "lucide-react";
import { motion, AnimatePresence } from "motion/react";

// ─── Types ───────────────────────────────────────────────────────────────────
type Page =
  | "landing"
  | "signin"
  | "signup"
  | "dashboard"
  | "editor"
  | "builder"
  | "explore"
  | "courses"
  | "profile"
  | "collab";

// ─── Leaf SVG Icon ────────────────────────────────────────────────────────────
function LeafIcon({ size = 24, className = "" }: { size?: number; className?: string }) {
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 32 32"
      fill="none"
      className={className}
    >
      <path
        d="M16 28C16 28 6 22 6 12C6 7.6 10.5 4 16 4C21.5 4 26 7.6 26 12C26 22 16 28 16 28Z"
        fill="currentColor"
        opacity="0.9"
      />
      <path
        d="M16 28C16 28 16 16 16 8"
        stroke="#F6F0E4"
        strokeWidth="1.5"
        strokeLinecap="round"
      />
      <path
        d="M16 14C16 14 12 12 10 10"
        stroke="#F6F0E4"
        strokeWidth="1.2"
        strokeLinecap="round"
        opacity="0.6"
      />
      <path
        d="M16 18C16 18 19.5 15.5 22 13"
        stroke="#F6F0E4"
        strokeWidth="1.2"
        strokeLinecap="round"
        opacity="0.6"
      />
    </svg>
  );
}

// ─── Animated Leaf (floating) ─────────────────────────────────────────────────
function FloatingLeaf({ delay = 0, size = 40, x = 0, y = 0, opacity = 0.15 }: {
  delay?: number; size?: number; x?: number; y?: number; opacity?: number;
}) {
  return (
    <motion.div
      className="absolute pointer-events-none text-accent"
      style={{ left: `${x}%`, top: `${y}%`, opacity }}
      animate={{ y: [0, -18, 0], rotate: [0, 8, -4, 0] }}
      transition={{ duration: 5 + delay, repeat: Infinity, delay, ease: "easeInOut" }}
    >
      <LeafIcon size={size} />
    </motion.div>
  );
}

// ─── Nav ──────────────────────────────────────────────────────────────────────
function TopNav({ current, onNav, loggedIn }: { current: Page; onNav: (p: Page) => void; loggedIn: boolean }) {
  const [menuOpen, setMenuOpen] = useState(false);
  return (
    <nav className="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-3 bg-card/90 backdrop-blur-sm border-b border-border shadow-sm">
      <button onClick={() => onNav("landing")} className="flex items-center gap-2 group">
        <span className="text-accent group-hover:scale-110 transition-transform">
          <LeafIcon size={28} />
        </span>
        <span className="font-['Playfair_Display'] text-xl font-bold text-foreground tracking-tight">Leaf</span>
      </button>

      {/* Desktop nav */}
      <div className="hidden md:flex items-center gap-1">
        {loggedIn ? (
          <>
            <NavBtn active={current === "dashboard"} onClick={() => onNav("dashboard")} icon={<Home size={15} />} label="Home" />
            <NavBtn active={current === "editor"} onClick={() => onNav("editor")} icon={<Feather size={15} />} label="Write" />
            <NavBtn active={current === "builder"} onClick={() => onNav("builder")} icon={<Layers size={15} />} label="Builder" />
            <NavBtn active={current === "explore"} onClick={() => onNav("explore")} icon={<Compass size={15} />} label="Explore" />
            <NavBtn active={current === "collab"} onClick={() => onNav("collab")} icon={<Users size={15} />} label="Collab" />
            <NavBtn active={current === "courses"} onClick={() => onNav("courses")} icon={<GraduationCap size={15} />} label="Courses" />
          </>
        ) : (
          <>
            <NavBtn active={false} onClick={() => onNav("explore")} icon={<Compass size={15} />} label="Explore" />
            <NavBtn active={false} onClick={() => onNav("courses")} icon={<GraduationCap size={15} />} label="Courses" />
          </>
        )}
      </div>

      <div className="flex items-center gap-2">
        {loggedIn ? (
          <>
            <button className="p-2 rounded-full hover:bg-muted transition-colors relative">
              <Bell size={18} className="text-muted-foreground" />
              <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-accent rounded-full" />
            </button>
            <button onClick={() => onNav("profile")} className="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-accent-foreground font-semibold text-sm hover:scale-105 transition-transform">
              A
            </button>
          </>
        ) : (
          <>
            <button onClick={() => onNav("signin")} className="text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-1.5">Sign in</button>
            <button onClick={() => onNav("signup")} className="text-sm bg-primary text-primary-foreground px-4 py-1.5 rounded-full hover:opacity-90 transition-opacity">
              Get started
            </button>
          </>
        )}
        <button className="md:hidden p-2" onClick={() => setMenuOpen(!menuOpen)}>
          <Menu size={20} />
        </button>
      </div>

      {/* Mobile menu */}
      <AnimatePresence>
        {menuOpen && (
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            className="absolute top-full left-0 right-0 bg-card border-b border-border p-4 flex flex-col gap-2 md:hidden"
          >
            {loggedIn ? (
              <>
                {(["dashboard","editor","builder","explore","collab","courses"] as Page[]).map(p => (
                  <button key={p} onClick={() => { onNav(p); setMenuOpen(false); }} className="text-left py-2 px-3 rounded-lg hover:bg-muted capitalize transition-colors">{p}</button>
                ))}
              </>
            ) : (
              <>
                <button onClick={() => { onNav("explore"); setMenuOpen(false); }} className="text-left py-2 px-3 rounded-lg hover:bg-muted">Explore</button>
                <button onClick={() => { onNav("courses"); setMenuOpen(false); }} className="text-left py-2 px-3 rounded-lg hover:bg-muted">Courses</button>
              </>
            )}
          </motion.div>
        )}
      </AnimatePresence>
    </nav>
  );
}

function NavBtn({ active, onClick, icon, label }: { active: boolean; onClick: () => void; icon: React.ReactNode; label: string }) {
  return (
    <button
      onClick={onClick}
      className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm transition-all ${
        active ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground hover:bg-muted"
      }`}
    >
      {icon}
      <span>{label}</span>
    </button>
  );
}

// ─── LANDING PAGE ─────────────────────────────────────────────────────────────
